# =============================================================================
# DEV (Laragon) — copier en .env
# =============================================================================
VITE_API_URL=http://localhost:3000

# =============================================================================
# PROD — pas de client/.env sur le serveur
# Build avec URL API vide (same origin, Express sert le front) :
#   PowerShell : $env:VITE_API_URL="" ; npm run build
# Le code utilise import.meta.env.VITE_API_URL || '' → requêtes /api/...

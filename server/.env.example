# =============================================================================
# DEV (Laragon) — copier en .env et adapter
# =============================================================================

PORT=3000

# CORS : URL du front Vite en dev
CLIENT_URL=http://localhost:5173

# MySQL Laragon (souvent root sans mot de passe)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=name_bdd
DB_USER=root
DB_PASSWORD=

SESSION_SECRET=une_chaine_longue_et_aleatoire

# Cookie session — false en HTTP local, true en HTTPS prod
COOKIE_SECURE=false

ADMIN_EMAIL=example@gmail.fr
ADMIN_PASSWORD=ton_mot_de_passe_ici


